# Personal/local Docker configuration for auth-svc
# Keep this file private and do not commit it to Git.

# PostgreSQL
# Must match the PostgreSQL container credentials/database in your docker-compose.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/app_db

# JWT
SECRET_KEY=supersecretkey123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Internal service-to-service authentication
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name
TRUSTED_SERVICE_TOKENS={"chat-svc":"BYEZz_Fo2sx1ypz1vcKTcPvJoAMCmMY6Q45ZDZ4FkOM"}
