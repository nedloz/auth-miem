# Personal/local Docker configuration for auth-svc
# Keep this file private and do not commit it to Git.

# PostgreSQL
# Must match the PostgreSQL container credentials/database in your docker-compose.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/app_db

# JWT
SECRET_KEY=supersecretkey123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Internal service-to-service authentication
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name
TRUSTED_SERVICE_TOKENS={"chat-svc":"super-secret-token-for-chat-svc"}

# =========================
# Админ-сессия (вход в панель db-svc за /admin/)
# =========================
# Короткоживущая HttpOnly-кука: переход в панель — обычная навигация браузера, в ней нет
# заголовка Authorization, поэтому access-токен туда не передать.
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_EXPIRE_MINUTES=30
ADMIN_SESSION_COOKIE_PATH=/admin
# В проде поставить true (кука только по HTTPS)
ADMIN_SESSION_COOKIE_SECURE=false
