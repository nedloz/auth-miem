# =========================================================
# PostgreSQL
# =========================================================

DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/app_db


# =========================================================
# JWT
# =========================================================

SECRET_KEY=supersecretkey123
ALGORITHM=HS256

# Уже существующая настройка access JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15


# =========================================================
# TOKEN LIFETIMES
# =========================================================

# 30 дней
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# 24 часа
EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=1440

# 1 час
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60


# =========================================================
# FRONTEND
# =========================================================

# Публичный URL frontend/nginx.
FRONTEND_BASE_URL=http://localhost


# =========================================================
# SMTP
# =========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USER=
SMTP_PASSWORD=

# Gmail: true для STARTTLS на 587
SMTP_USE_TLS=true

# Для SMTPS обычно используется 465
SMTP_USE_SSL=false

EMAIL_FROM=


# =========================================================
# REDIS
# =========================================================

# При запуске напрямую.
# В основном docker-compose значение также
# передаётся через environment.
# За mTLS-прокси (docker-compose.mtls.yml) адрес другой: rediss://auth-svc:<пароль>@redis:6380/0,
# compose подставляет его сам (пароль из scripts/gen_redis_acl.py).
REDIS_URL=redis://redis:6379/0

# TTL профилей в Redis:
# 5 минут
PROFILE_CACHE_TTL_SECONDS=300


# =========================================================
# Internal service-to-service authentication
# =========================================================

# Режим внутренней аутентификации: mtls (по умолчанию) — имя вызывающего берётся из X-Caller-Identity,
# который проставляет прокси-сайдкар (см. infra/mtls); insecure — без проверки, только для отладки.
INTERNAL_AUTH_MODE=mtls


# =========================================================
# Admin session
# =========================================================

ADMIN_SESSION_COOKIE_NAME=admin_session

ADMIN_SESSION_EXPIRE_MINUTES=30

ADMIN_SESSION_COOKIE_PATH=/admin

# В production за HTTPS:
ADMIN_SESSION_COOKIE_SECURE=false
